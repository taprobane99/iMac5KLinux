+static void edid_extension_tags_to_str(const struct edid *edid,
+				       char *buf, size_t len)
+{
+	size_t pos = 0;
+	u8 i;
+
+	if (!len)
+		return;
+
+	buf[0] = '\0';
+	for (i = 1; i <= edid->extensions; i++) {
+		const u8 *block = (const u8 *)edid + i * EDID_LENGTH;
+
+		pos += scnprintf(buf + pos, len - pos, "%s0x%02X",
+				 pos ? "," : "", block[0]);
+		if (pos >= len)
+			break;
+	}
+}

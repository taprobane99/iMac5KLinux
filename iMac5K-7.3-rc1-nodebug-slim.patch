+/*
+ * Cross-wire tiled_peer between eDP root and DP slave so the slave can reach
+ * the root latch pulse during pre-detection when slave local_sink is NULL.
+ */
+static void dm_helpers_wire_tiled_peer(struct dc_link *link)
+{
+	enum signal_type target_signal;
+	uint32_t i;
+
+	if (!link->dc || link->tiled_peer)
+		return;
+
+	if (link->connector_signal == SIGNAL_TYPE_EDP) {
+		target_signal = SIGNAL_TYPE_DISPLAY_PORT;
+	} else if (link->connector_signal == SIGNAL_TYPE_DISPLAY_PORT) {
+		target_signal = SIGNAL_TYPE_EDP;
+	} else {
+		return;
+	}
+
+	for (i = 0; i < link->dc->link_count; i++) {
+		struct dc_link *other = link->dc->links[i];
+
+		/*
+		 * Match the complementary internal panel link (index 0 for root,
+		 * index 1 for slave) to avoid pairing with external DP displays.
+		 */
+		if (other && other != link && !other->tiled_peer &&
+		    other->connector_signal == target_signal &&
+		    (other->link_index == 0 || other->link_index == 1)) {
+			link->tiled_peer = other;
+			other->tiled_peer = link;
+			return;
+		}
+	}
+}

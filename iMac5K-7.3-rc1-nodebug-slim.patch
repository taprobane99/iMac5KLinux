+#define DP_LT_AUX_READY_ATTEMPTS           2
+
+/*
+ * Ensure the secondary tile TCON is awake and answering AUX reads before
+ * beginning DisplayPort link training.
+ */
+static bool dp_prepare_sink_for_link_training(struct dc_link *link,
+					      unsigned int attempts)
+{
+	uint8_t power_state = DP_POWER_STATE_D0;
+	uint8_t dpcd_rev = 0;
+	unsigned int try;
+
+	if (!link || link->aux_access_disabled ||
+	    !dc_link_is_apple_5k_slave(link))
+		return true;
+
+	/* Fast path: bail out if slave AUX is already awake and responsive */
+	if (core_link_read_dpcd(link, DP_DPCD_REV, &dpcd_rev, sizeof(dpcd_rev)) == DC_OK &&
+	    dpcd_rev != 0)
+		return true;
+
+	/* Slave is asleep: pulse root latch and set D0 once */
+	link_apple_5k_root_panel_latch_pulse(link->tiled_peer);
+	core_link_write_dpcd(link, DP_SET_POWER, &power_state, sizeof(power_state));
+
+	for (try = 0; try < attempts; try++) {
+		dpcd_rev = 0;
+		if (core_link_read_dpcd(link, DP_DPCD_REV,
+					&dpcd_rev, sizeof(dpcd_rev)) == DC_OK &&
+		    dpcd_rev != 0)
+			return true;
+
+		if (try + 1 < attempts)
+			fsleep(1000); /* DP_LT_AUX_READY_COOLDOWN_US */
+	}
+
+	return false;
+}

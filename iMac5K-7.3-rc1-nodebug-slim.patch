+void amdgpu_dm_reprobe_tiled_root_after_slave(struct amdgpu_device *adev)
+{
+	struct drm_device *dev = adev_to_drm(adev);
+	struct amdgpu_display_manager *dm = &adev->dm;
+	struct drm_connector_list_iter iter;
+	struct drm_connector *connector;
+	struct amdgpu_dm_connector *primary = NULL;
+	struct amdgpu_dm_connector *secondary = NULL;
+	struct dc_link *link;
+	struct dc_sink *sink;
+
+	drm_connector_list_iter_begin(dev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		struct amdgpu_dm_connector *aconnector;
+
+		if (connector->connector_type == DRM_MODE_CONNECTOR_WRITEBACK)
+			continue;
+
+		aconnector = to_amdgpu_dm_connector(connector);
+		if (dc_link_is_apple_5k_root(aconnector->dc_link))
+			primary = aconnector;
+		else if (dc_link_is_apple_5k_slave(aconnector->dc_link))
+			secondary = aconnector;
+	}
+	drm_connector_list_iter_end(&iter);
+
+	/* Both connectors must exist and secondary tile metadata must already be valid */
+	if (!primary || !secondary || !amdgpu_dm_connector_is_tiled_slave_tile(secondary))
+		return;
+
+	/* Early exit: avoid acquiring locks or reading DDC if root already has tile info */
+	if (primary->base.has_tile)
+		return;
+
+	link = primary->dc_link;
+	sink = link ? link->local_sink : NULL;
+	if (!sink)
+		return;
+
+	mutex_lock(&dm->dc_lock);
+	dc_exit_ips_for_hw_access(dm->dc);
+	dm_helpers_read_local_edid(link->ctx, link, sink);
+	mutex_unlock(&dm->dc_lock);
+
+	/* Synchronize DRM connector EDID representation with the updated DC sink EDID */
+	if (sink->dc_edid.length) {
+		const struct edid *edid = (const struct edid *)sink->dc_edid.raw_edid;
+
+		drm_edid_free(primary->drm_edid);
+		primary->drm_edid = drm_edid_alloc(edid, sink->dc_edid.length);
+		mutex_lock(&dev->mode_config.mutex);
+		drm_edid_connector_update(&primary->base, primary->drm_edid);
+		mutex_unlock(&dev->mode_config.mutex);
+	}
+}

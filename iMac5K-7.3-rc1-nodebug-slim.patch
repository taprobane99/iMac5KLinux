+static bool tiled_secondary_poll_aux(struct dc_link *link,
+				 struct dc_link *root_link)
+{
+	uint8_t dpcd_rev;
+	int retries;
+
+	if (!link || !link->ddc)
+		return false;
+
+	/* Pulse root latch to keep the secondary TCON AUX interface alive */
+	if (root_link)
+		link_apple_5k_root_panel_latch_set(root_link);
+
+	/* Poll up to 300 ms (60 retries * 5 ms) */
+	for (retries = 0; retries < 60; retries++) {
+		dpcd_rev = 0;
+		if (core_link_read_dpcd(link, DP_DPCD_REV, &dpcd_rev, sizeof(dpcd_rev)) == DC_OK &&
+		    dpcd_rev != 0)
+			return true;
+
+		fsleep(5000); /* 5 ms settle window between AUX probes */
+	}
+
+	return false;
+}

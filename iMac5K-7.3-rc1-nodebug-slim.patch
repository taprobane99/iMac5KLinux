+static bool
+amdgpu_dm_connector_is_tiled_slave_tile(const struct amdgpu_dm_connector *aconnector)
+{
+	const struct drm_connector *c = aconnector ? &aconnector->base : NULL;
+
+	return c && c->has_tile && c->tile_h_size && c->tile_v_size &&
+	       (c->tile_h_loc || c->tile_v_loc) &&
+	       dc_link_is_apple_5k_slave(aconnector->dc_link);
+}
+
+static bool
+amdgpu_dm_mode_matches_tile_size(const struct drm_connector *connector,
+				 const struct drm_display_mode *mode)
+{
+	return connector &&
+	       connector->has_tile &&
+	       connector->tile_h_size &&
+	       connector->tile_v_size &&
+	       mode &&
+	       mode->hdisplay == connector->tile_h_size &&
+	       mode->vdisplay == connector->tile_v_size;
+}
+
+/*
+ * Some tiled panels advertise fallback modes as preferred. For patched panels,
+ * make the mode matching DRM tile metadata the sole preferred mode.
+ */
+static void
+amdgpu_dm_make_tile_mode_preferred(struct drm_connector *connector)
+{
+	struct amdgpu_dm_connector *aconnector = to_amdgpu_dm_connector(connector);
+	struct drm_display_mode *mode;
+
+	if (!connector->has_tile || !aconnector ||
+	    (!dc_link_is_apple_5k_root(aconnector->dc_link) &&
+	     !dc_link_is_apple_5k_slave(aconnector->dc_link)))
+		return;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		if (amdgpu_dm_mode_matches_tile_size(connector, mode))
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+		else
+			mode->type &= ~DRM_MODE_TYPE_PREFERRED;
+	}
+}

+/*
+ * Some embedded DP sinks expose AUX before they are consistently ready for
+ * link-training writes. For panels that request it, make training conditional
+ * on an observed AUX response after any panel-specific pre-training wake.
+ */
+#define DP_LT_AUX_READY_ATTEMPTS           3
+
+static bool dp_prepare_sink_for_link_training(struct dc_link *link,
+					      unsigned int attempts)
+{
+	uint8_t power_state = DP_POWER_STATE_D0;
+	uint8_t dpcd_rev = 0;
+	unsigned int try;
+
+	if (!link || link->aux_access_disabled ||
+	    !dc_link_is_apple_5k_slave(link))
+		return true;
+
+	/*
+	 * Fast path: if the slave AUX is already awake and responsive,
+	 * skip pulsing the root latch and return immediately.
+	 */
+	if (core_link_read_dpcd(link, DP_DPCD_REV, &dpcd_rev, sizeof(dpcd_rev)) == DC_OK &&
+	    dpcd_rev != 0)
+		return true;
+
+	/* Slave is asleep: pulse root latch once to wake secondary TCON rail */
+	link_apple_5k_root_panel_latch_pulse(link->tiled_peer);
+
+	for (try = 0; try < attempts; try++) {
+		if (core_link_write_dpcd(link, DP_SET_POWER,
+					 &power_state, sizeof(power_state)) == DC_OK) {
+			dpcd_rev = 0;
+			if (core_link_read_dpcd(link, DP_DPCD_REV,
+						&dpcd_rev, sizeof(dpcd_rev)) == DC_OK &&
+			    dpcd_rev != 0)
+				return true;
+		}
+
+		if (try + 1 < attempts)
+			fsleep(1000); /* 1 ms settle backoff */
+	}
+
+	return false;
+}

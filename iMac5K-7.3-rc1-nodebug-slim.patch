+ * From the root side, pick the first DP sibling. From the slave side,
+ * pick the first eDP sibling already carrying the root flag.
+ */
+static void dm_helpers_wire_tiled_peer(struct dc_link *link,
+				       const struct dc_edid_caps *edid_caps)
+{
+	bool is_apple_5k = edid_caps->panel_patch.is_apple_5k_tiled_panel;
+	bool is_root = is_apple_5k && link->connector_signal == SIGNAL_TYPE_EDP;
+	bool is_slave = is_apple_5k && link->connector_signal == SIGNAL_TYPE_DISPLAY_PORT;
+	uint32_t i;
+
+	if (!link->dc || (!is_root && !is_slave) || link->tiled_peer)
+		return;
+
+	for (i = 0; i < link->dc->link_count; i++) {
+		struct dc_link *other = link->dc->links[i];
+
+		if (!other || other == link || other->tiled_peer)
+			continue;
+
+		if (is_root && other->connector_signal == SIGNAL_TYPE_DISPLAY_PORT) {
+			link->tiled_peer = other;
+			other->tiled_peer = link;
+			return;
+		}

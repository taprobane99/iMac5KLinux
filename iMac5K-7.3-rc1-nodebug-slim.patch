+/*
+ * Ensure the secondary tile TCON is awake and answering AUX reads before
+ * beginning DisplayPort link training.
+ */
+static bool dp_prepare_sink_for_link_training(struct dc_link *link)
+{
+	uint8_t dpcd_rev = 0;
+
+	if (!dc_link_is_apple_5k_secondary(link))
+		return true;
+
+	/* Fast path: secondary is already awake */
+	if (core_link_read_dpcd(link, DP_DPCD_REV, &dpcd_rev, sizeof(dpcd_rev)) == DC_OK && dpcd_rev)
+		return true;
+
+	/* Wake secondary via root latch and assert D0 */
+	link_apple_5k_root_panel_latch_set(link->tiled_peer);
+	core_link_write_dpcd(link, DP_SET_POWER, &(uint8_t){DP_POWER_STATE_D0}, 1);
+	fsleep(1000);
+
+	return core_link_read_dpcd(link, DP_DPCD_REV, &dpcd_rev, sizeof(dpcd_rev)) == DC_OK && dpcd_rev;
+}

+/* Helpers to identify the primary (eDP) and secondary (DP) tiles of the Apple 5K panel. */
+static inline bool dc_link_is_apple_5k_root(const struct dc_link *link)
+{
+	return link && link->connector_signal == SIGNAL_TYPE_EDP &&
+	       link->local_sink && link->local_sink->edid_caps.panel_patch.is_apple_5k_tiled_panel;
+}
+
+static inline bool dc_link_is_apple_5k_secondary(const struct dc_link *link)
+{
+	return link && link->connector_signal == SIGNAL_TYPE_DISPLAY_PORT &&
+	       ((link->local_sink && link->local_sink->edid_caps.panel_patch.is_apple_5k_tiled_panel) ||
+	        dc_link_is_apple_5k_root(link->tiled_peer));
+}
 

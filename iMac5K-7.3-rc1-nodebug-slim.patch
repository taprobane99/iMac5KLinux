+/* Ensure DDC is in AUX mode before pulsing the root panel wake latch */
+static enum dc_status tiled_root_write_panel_wake(struct dc_link *link)
+{
+	if (!dc_link_is_apple_5k_root(link) || !link->ddc || !link->local_sink)
+		return DC_OK;
+
+/* Configure DDC to AUX mode if not already active before pulsing latch */
+	if (!link->aux_mode) {
+		set_ddc_transaction_type(link->ddc, DDC_TRANSACTION_TYPE_I2C_OVER_AUX);
+		link->aux_mode = link_is_in_aux_transaction_mode(link->ddc);
+	}
+
+	return link_apple_5k_root_panel_latch_pulse(link);
+}
+
+/*
+ * Pulse root latch and poll secondary AUX to confirm physical panel presence
+ * even when the slave link reports HPD low.
+ */
+static bool tiled_slave_poll_aux(struct dc_link *link,
+				 struct dc_link *root_link)
+{
+	enum ddc_transaction_type old_transaction_type;
+	bool old_aux_mode;
+	enum dc_status status;
+	uint8_t dpcd_rev = 0;
+	unsigned int elapsed_ms;
+
+	if (!link || !link->ddc)
+		return false;
+
+	old_transaction_type = link->ddc->transaction_type;
+	old_aux_mode = link->aux_mode;
+
+	set_ddc_transaction_type(link->ddc, DDC_TRANSACTION_TYPE_I2C_OVER_AUX);
+	link->aux_mode = link_is_in_aux_transaction_mode(link->ddc);
+
+/*
+ * Pulse root latch on secondary-only HPDRX re-detects where the root's own
+ * detection path did not fire, keeping the secondary AUX interface alive.
+ */
+	if (root_link)
+		tiled_root_write_panel_wake(root_link);
+
+	for (elapsed_ms = 0; elapsed_ms < 100; elapsed_ms += 3) { /* TILED_SLAVE_AUX_WAKE_TIMEOUT_MS */
+		dpcd_rev = 0;
+		status = core_link_read_dpcd(link, DP_DPCD_REV,
+					    &dpcd_rev, sizeof(dpcd_rev));
+
+		if (status == DC_OK && dpcd_rev != 0)
+			return true;
+
+		fsleep(3000); /* TILED_SLAVE_AUX_WAKE_POLL_MS */
+	}
+
+	set_ddc_transaction_type(link->ddc, old_transaction_type);
+	link->aux_mode = old_aux_mode;
+
+	return false;
+}

+static void amdgpu_dm_apple5k_unlatch_on_shutdown(struct amdgpu_device *adev)
+{
+	const uint8_t zeros[3] = { 0 };
+	struct dc *dc;
+	int i;
+
+	if (!adev || !adev->dm.dc)
+		return;
+
+	dc = adev->dm.dc;
+
+	for (i = 0; i < dc->link_count; i++) {
+		struct dc_link *link = dc->links[i];
+
+		if (!dc_link_is_apple_5k_secondary(link))
+			continue;
+
+		/* Clear Boot Camp tables and unlatch secondary tile */
+		core_link_write_dpcd(link, 0x310, zeros, 3);
+		core_link_write_dpcd(link, 0x10A, zeros, 1);
+		core_link_write_dpcd(link, 0x4F1, zeros, 1);
+
+		/* Unlatch primary root tile */
+		if (link->tiled_peer)
+			core_link_write_dpcd(link->tiled_peer, 0x4F1, zeros, 1);
+		
+		break;
+	}
+}

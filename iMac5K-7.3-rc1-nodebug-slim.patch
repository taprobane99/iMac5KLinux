+static inline bool dc_link_is_apple_5k_slave(const struct dc_link *link)
+{
+	if (!link || link->connector_signal != SIGNAL_TYPE_DISPLAY_PORT)
+		return false;
+	if (link->local_sink && link->local_sink->edid_caps.panel_patch.is_apple_5k_tiled_panel)
+		return true;
+	return dc_link_is_apple_5k_root(link->tiled_peer);

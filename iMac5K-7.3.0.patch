+/* Unlatch Apple 5K panel tiles and reset DPCD state on suspend/shutdown.
+ * This returns the TCON to single-pipe mode so the EFI boot logo is not skewed on reboot. */
+static void amdgpu_dm_apple5k_unlatch(struct amdgpu_device *adev)
+{
+	const uint8_t zeros[3] = { 0 };
+
+	for (int i = 0; i < adev->dm.dc->link_count; i++) {
+		struct dc_link *link = adev->dm.dc->links[i];
+
+		if (dc_link_is_apple_5k_secondary(link)) {
+			/* Clear Boot Camp source table (0x310), eDP config (0x10A), and secondary tile latch (0x4F1) */
+			core_link_write_dpcd(link, DP_SOURCE_TABLE_REVISION, zeros, 3);
+			core_link_write_dpcd(link, DP_EDP_CONFIGURATION_SET, zeros, 1);
+			core_link_write_dpcd(link, 0x4F1, zeros, 1);
+
+			/* Unlatch primary root tile */
+			core_link_write_dpcd(link->tiled_peer, 0x4F1, zeros, 1);
+
+			break;
+		}
+	}
+}
+
 static int dm_suspend(struct amdgpu_ip_block *ip_block)
 {
 	struct amdgpu_device *adev = ip_block->adev;
@@ -1632,6 +1655,8 @@
 
 	amdgpu_dm_hpd_rx_irq_work_suspend(dm);
 
+	amdgpu_dm_apple5k_unlatch(adev);
+
 	dc_set_power_state(dm->dc, DC_ACPI_CM_POWER_STATE_D3);
 
 	if (dm->dc->caps.ips_support && adev->in_s0ix)
@@ -4626,6 +4651,13 @@
 	mutex_lock(&dm->dc_lock);
 	dc_exit_ips_for_hw_access(dm->dc);
 	WARN_ON(!dc_commit_streams(dm->dc, &params));
+	/* DCE < 12 leaves all_displays_in_sync unset; report synchronized Apple 5K tiles to
+ 	 * PowerPlay after commit so SMU7 can downclock MCLK at idle without modeset underflows. */
+	if (params.stream_count == 2 && dm->dc->config.multi_mon_pp_mclk_switch &&
+	    params.streams[0]->link->tiled_peer == params.streams[1]->link) {
+		dm->dc->current_state->pp_display_cfg.all_displays_in_sync = true;
+		dm_pp_apply_display_requirements(dm->dc->ctx, &dm->dc->current_state->pp_display_cfg);
+	}
 
 	bool frl_stream_found = false;
 
@@ -5009,6 +5041,11 @@
 		 * crtc_sync_master.multi_sync_enabled flag
 		 * For now it's set to false
 		 */
+		/* Enable per-frame CRTC reset on DCE >= 12 so set_master_stream() keeps tiles genlocked
+ 		 * (DCE < 12 uses one-shot modeset timing sync and has a broken per-frame reset path). */
+		if (context->streams[i]->link->tiled_peer &&
+		    context->streams[i]->ctx->dce_version >= DCE_VERSION_12_0)
+			context->streams[i]->triggered_crtc_reset.enabled = true;
 	}
 
 	set_master_stream(context->streams, context->stream_count);
